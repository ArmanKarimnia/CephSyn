# ==============================================================================
# CephSync Enterprise: Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual cluster endpoints and secrets.
# NEVER commit raw credentials or '.env' files to version control!
# ==============================================================================

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Primary Ceph Object Gateway (Source) ---
SOURCE_S3_ENDPOINT_URL="http://192.168.10.11:8080"
SOURCE_S3_ACCESS_KEY="CEPH_RGW_ACCESS_KEY_HERE"
SOURCE_S3_SECRET_KEY="CEPH_RGW_SECRET_KEY_HERE"
SOURCE_S3_REGION_NAME="default"
SOURCE_S3_VERIFY_SSL="true"

# --- Target S3 / Ceph Backup Cluster (Destination) ---
# Note: For AWS S3, set DEST_S3_ENDPOINT_URL to empty or https://s3.<region>.amazonaws.com
DEST_S3_ENDPOINT_URL="https://s3.us-east-1.amazonaws.com"
DEST_S3_ACCESS_KEY="BACKUP_S3_ACCESS_KEY_HERE"
DEST_S3_SECRET_KEY="BACKUP_S3_SECRET_KEY_HERE"
DEST_S3_REGION_NAME="us-east-1"
DEST_S3_VERIFY_SSL="true"

# --- S3 Sync Engine Runtime Parameters ---
DEFAULT_SOURCE_BUCKET="production-primary-assets"
DEFAULT_DEST_BUCKET="dr-backup-assets"
SYNC_WORKERS=12
MULTIPART_THRESHOLD_MB=16
CHUNK_SIZE_MB=8
LOG_LEVEL="INFO"
DRY_RUN="false"
DELETE_ORPHANS="false"

# --- Ceph Bootstrap Parameters (Optional Overrides) ---
CEPH_NODE_1="ceph-node01"
CEPH_NODE_2="ceph-node02"
CEPH_NODE_3="ceph-node03"
RGW_PORT="8080"
REALM_NAME="production-realm"
ZONEGROUP_NAME="default"
ZONE_NAME="default"
RGW_ADMIN_UID="s3-backup-admin"
